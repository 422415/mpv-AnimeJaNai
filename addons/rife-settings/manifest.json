{
  "schemaVersion": 1,
  "id": "org.animejanai.rife-settings",
  "name": "RIFE Settings",
  "version": "0.1.0",
  "api": { "major": 1, "minMinor": 10 },
  "permissions": ["player.sceneDetection", "frames.read"],
  "requiredCapabilities": { "sceneDetection": { "major": 1, "minMinor": 1 } },
  "activation": ["manual", "on_player"],
  "settings": {
    "sceneMode": { "type": "choice", "label": "Scene detection (mvtools restores the sc_mode=2 algorithm)", "default": "mvtools", "choices": ["mvtools", "default"] },
    "thscd1": { "type": "number", "label": "MVTools block difference threshold (legacy: 240)", "default": 240, "minimum": 0, "maximum": 16320 },
    "thscd2": { "type": "number", "label": "MVTools changed-block threshold, out of 256 (legacy: 130)", "default": 130, "minimum": 0, "maximum": 255 }
  },
  "actions": {
    "status": { "label": "Show RIFE scene detector status" },
    "apply": { "label": "Apply settings to open players" }
  }
}
